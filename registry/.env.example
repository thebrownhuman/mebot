# Copy to .env and fill in. Never commit .env.

# Bearer token for GET /v1/stats (the maintainer's view). Empty = the endpoint is disabled.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
REGISTRY_ADMIN_TOKEN=

# Maintainer Telegram: create a bot with @BotFather, send it /start, then find your chat id
# (e.g. via @userinfobot). Leave empty to run without notifications.
REGISTRY_TELEGRAM_BOT_TOKEN=
REGISTRY_TELEGRAM_CHAT_ID=

# Weekly summary: Monday 09:00 in this IANA zone.
REGISTRY_TIMEZONE=Asia/Kolkata

# Comma-separated emails or domains that may not register.
REGISTRY_BLOCKLIST=

# Behind a reverse proxy / tunnel, set to 1 so rate limits use the real client address
# from X-Forwarded-For. Leave 0 when the service is reachable directly: otherwise anyone
# could pick their own address.
REGISTRY_TRUST_PROXY=1
