# Copy to .env and edit. The backend reads ./.env (repo root) or backend/.env.

# single = one bot, no tenancy (default). hosted = multi-bot (later features).
MODE=single

# Session/signing secret. Required when MODE=hosted.
# In single mode, leave empty: one is generated once and saved to <DATA_DIR>/secret.key.
SECRET_KEY=

# Where the SQLite db and generated secret.key live. Default: backend/data
# DATA_DIR=

# SQLAlchemy URL. Default: sqlite:///<DATA_DIR>/mebot.db
# DATABASE_URL=sqlite:///data/mebot.db

# Anonymous usage telemetry (on|off). Not used yet.
TELEMETRY=on

# Ollama server and preferred model (falls back to gemma4:e2b-it-qat if missing).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=me-bot

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
