# mebot configuration. Copy to .env and edit; everything is optional.
# Docker: put .env next to docker-compose.yml. From source: repo root or backend/.env.
# Full reference: docs/configuration.md

# ---------------------------------------------------------------------------------------
# Docker compose only (read by docker-compose.yml, not by mebot)
# ---------------------------------------------------------------------------------------
# GitHub account the image is published under: ghcr.io/<MEBOT_OWNER>/mebot
# MEBOT_OWNER=
# Pin an image version instead of latest, e.g. 0.9.0
# MEBOT_VERSION=latest

# ---------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------
# single = one bot, no tenancy (default). hosted = multi-bot (later releases).
MODE=single

# Encrypts stored API keys and keys the IP hashes. Required when MODE=hosted.
# In single mode, leave empty: one is generated once and saved to <DATA_DIR>/secret.key.
# Changing it later means re-entering your API keys.
SECRET_KEY=

# Where the SQLite db, secret.key and install.key live. The Docker image uses /data.
# Default from source: backend/data
# DATA_DIR=

# SQLAlchemy URL. Default: sqlite:///<DATA_DIR>/mebot.db
# DATABASE_URL=

# First-run protection. If set, the /setup form must include this token. Recommended
# whenever the first boot is reachable from the internet (otherwise whoever opens the
# site first becomes the admin).
SETUP_TOKEN=

# The AI provider, model and your API key are set in the setup wizard / Admin ->
# AI Provider, not here. Default base URL suggested for the Ollama provider:
OLLAMA_HOST=http://127.0.0.1:11434

# ---------------------------------------------------------------------------------------
# Public address, proxy and browser
# ---------------------------------------------------------------------------------------
# Public https address of this install (no trailing slash), e.g. https://bot.example.com.
# Used in widget snippets, Telegram webhook mode and "Open chat" links. Leave empty on
# localhost: Telegram then uses long polling, which needs no public address.
PUBLIC_URL=

# Comma-separated list of allowed browser origins. Also used by the CSRF check:
# state-changing admin requests must come from the same host or one of these.
# Docker quickstart: http://localhost:8080. Dev (Vite): http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Force the Secure flag on auth cookies. Set to true when HTTPS is terminated by a
# reverse proxy in front of mebot (the app itself then only sees plain http).
COOKIE_SECURE=false

# Trust X-Forwarded-Proto / X-Forwarded-For from a reverse proxy (client IP for rate
# limits, https detection). Only enable when mebot is reachable solely via that proxy.
TRUST_PROXY=false

# Optional Cloudflare Turnstile bot check before a visitor's chat starts. Set both keys,
# then switch it on in Admin -> Limits. If Cloudflare is unreachable, new chats fail
# closed (visitors see a friendly message) until you switch it off again.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------------------
# Telemetry (see docs/telemetry.md)
# ---------------------------------------------------------------------------------------
# on = a daily anonymous heartbeat and an update check; off = mebot never contacts the
# registry.
TELEMETRY=on
# REGISTRY_URL=https://registry.shivanshmishra.in

# ---------------------------------------------------------------------------------------
# Integrations and advanced
# ---------------------------------------------------------------------------------------
# Optional token for GitHub imports (no scopes; raises the 60 requests/hour limit).
# A token saved in Admin -> Import takes precedence.
# GITHUB_TOKEN=

# Retrieval for large profiles: above this many estimated tokens the bot sends only the
# parts of the profile relevant to each question (override per bot in Admin -> Knowledge).
# RETRIEVAL_THRESHOLD_TOKENS=6000
# Token budget for the retrieved excerpts in one prompt.
# RETRIEVAL_BUDGET_TOKENS=2500

# Background tasks in this process (Telegram: receiving updates, sending queued
# messages, daily digest; telemetry: heartbeat, registration, update check).
TELEGRAM_WORKERS=true
TELEMETRY_WORKERS=true

# Built frontend (npm run build). When it contains index.html the backend serves the
# whole UI. The Docker image uses /app/static. Default from source: frontend/dist
# FRONTEND_DIST=

# ---------------------------------------------------------------------------------------
# Hosted mode (MODE=hosted) only
# ---------------------------------------------------------------------------------------
# Hosted needs Postgres: DATABASE_URL=postgresql+psycopg://user:pass@host/db
# ALLOW_SQLITE_HOSTED=false
# HOSTED_DOMAIN=
# SIGNUP_MODE=invite
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=mebot <no-reply@localhost>
# PLATFORM_TELEGRAM_BOT_TOKEN=
# PLATFORM_TELEGRAM_CHAT_ID=
# HOSTED_MAX_DAILY_MESSAGES=500
# HOSTED_MAX_DAILY_TOKENS=1000000
# HOSTED_MAX_SESSION_MESSAGES=40
# HOSTED_MAX_IP_PER_DAY=100
# HOSTED_MAX_IMPORTS_PER_DAY=10
# HOSTED_MAX_UPLOAD_BYTES=5000000

# --- Paid plans (MODE=hosted only). Leave BILLING_PROVIDERS empty: billing off, all free.
# Use provider TEST-mode keys until launch. Secrets come from env only, never the DB.
# BILLING_PROVIDERS=razorpay,stripe
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_GRACE_DAYS=7
# TRIAL_DAYS=14
# TRIAL_MESSAGES=200
# TERMS_VERSION=2026-10
# PLATFORM_GSTIN=
