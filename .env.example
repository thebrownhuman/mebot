# Copy to .env and edit. The backend reads ./.env (repo root) or backend/.env.

# single = one bot, no tenancy (default). hosted = multi-bot (later features).
MODE=single

# Session/signing secret. Required when MODE=hosted.
# In single mode, leave empty: one is generated once and saved to <DATA_DIR>/secret.key.
SECRET_KEY=

# Where the SQLite db and generated secret.key live. Default: backend/data
# DATA_DIR=

# SQLAlchemy URL. Default: sqlite:///<DATA_DIR>/mebot.db
# DATABASE_URL=sqlite:///data/mebot.db

# Anonymous usage telemetry (on|off). Not used yet.
TELEMETRY=on

# The AI provider, model and your API key are set in the setup wizard / Admin ->
# AI Provider, not here. The key is stored encrypted with SECRET_KEY: changing
# SECRET_KEY later means re-entering it.
#
# Default base URL suggested for the Ollama provider.
OLLAMA_HOST=http://127.0.0.1:11434

# Comma-separated list of allowed browser origins. Also used by the CSRF check:
# state-changing admin requests must come from the same host or one of these.
CORS_ORIGINS=http://localhost:5173

# First-run protection. If set, the /setup form must include this token. Recommended
# whenever the first boot is reachable from the internet (otherwise whoever opens the
# site first becomes the admin).
SETUP_TOKEN=

# Force the Secure flag on auth cookies. Set to true when HTTPS is terminated by a
# reverse proxy in front of mebot (the app itself then only sees plain http).
COOKIE_SECURE=false

# Trust X-Forwarded-Proto / X-Forwarded-For from a reverse proxy (client IP for login
# rate limiting, https detection). Only enable when mebot is reachable solely via that
# proxy; deploy/docker-compose.yml sets it for the bundled nginx.
TRUST_PROXY=false

# Optional Cloudflare Turnstile bot check before a visitor's chat starts. Set both keys,
# then switch it on in Admin -> Limits. If Cloudflare is unreachable, new chats fail
# closed (visitors see a friendly message) until you switch it off again.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public https address of this install (no trailing slash), e.g. https://bot.example.com.
# Enables Telegram webhook mode and the "Open chat" button in notifications. Leave empty
# on localhost: Telegram then uses long polling, which needs no public address.
PUBLIC_URL=

# Run the Telegram background tasks (receiving updates, sending queued messages, daily
# digest) in this process. Set false on extra workers when running several processes.
TELEGRAM_WORKERS=true

# Built frontend (npm run build). Without nginx, the backend serves the widget loader and
# embed bundle from here. Default: frontend/dist next to backend/.
# FRONTEND_DIST=

# Optional token for GitHub imports (no scopes; raises the 60 requests/hour limit).
# A token saved in Admin -> Import takes precedence.
# GITHUB_TOKEN=
