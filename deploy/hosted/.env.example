# Hosted mebot. Copy to .env next to docker-compose.yml. Full reference: docs/configuration.md

# Public domain of the platform (DNS A/AAAA record pointing at this host).
DOMAIN=bots.example.com
# Optional wildcard: alice.bots.example.com serves /b/alice (needs a wildcard cert).
# HOSTED_DOMAIN=bots.example.com

# Required. Encrypts tenants' API keys and keys the IP hashes. Never change it.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Who may sign up: open | invite | closed. invite = an invite code goes live at once,
# no code waits in the operator's approval queue.
SIGNUP_MODE=invite

# Required for sign-up (bot check). https://dash.cloudflare.com -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Verification and password-reset mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=mebot <no-reply@bots.example.com>

# Optional maintainer pings (new sign-ups, suspensions) to your own Telegram.
# PLATFORM_TELEGRAM_BOT_TOKEN=
# PLATFORM_TELEGRAM_CHAT_ID=

# Per-tenant hard caps (owners can lower, never raise).
# HOSTED_MAX_DAILY_MESSAGES=500
# HOSTED_MAX_DAILY_TOKENS=1000000

# Image under ghcr.io/<MEBOT_OWNER>/mebot
# MEBOT_OWNER=
# MEBOT_VERSION=latest
